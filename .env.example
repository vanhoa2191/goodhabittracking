# Supabase Cloud Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable after applying the child journal migration and checking child device access.
NEXT_PUBLIC_DAILY_JOURNAL=false
NEXT_PUBLIC_DREAM_CITY=false

# PayOS VietQR Payment Gateway (required for checkout and webhook processing)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Unsafe legacy/demo server routes are disabled by default and ignored in production.
ENABLE_PAYMENT_SIMULATION=false
ENABLE_LEGACY_PAIRING=false
# Minimum 32 random characters in deployed environments.
PAIRING_RATE_LIMIT_SECRET=

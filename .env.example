# Supabase Cloud Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
# Emergency recovery only. Must be a future ISO timestamp no more than 24 hours
# away; bootstrap can only create its own expiring DB membership.
ADMIN_BOOTSTRAP_EXPIRES_AT=
# Deployment target: combined (legacy default), marketing, or app.
# Production split builds require both HTTPS origins. App/combined also require
# the public Supabase configuration above; marketing builds do not receive it.
NEXT_PUBLIC_DEPLOY_TARGET=combined
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# Split production values:
# NEXT_PUBLIC_APP_URL=https://app.kidhabithero.com
# NEXT_PUBLIC_MARKETING_URL=https://kidhabithero.com
# Lets the marketing site know a parent is signed in (an identity-free cookie). Only set a domain
# both origins share; shared hosting suffixes such as workers.dev are ignored.
# NEXT_PUBLIC_SESSION_HINT_DOMAIN=kidhabithero.com
# Enable after applying the child journal migration and checking child device access.
NEXT_PUBLIC_DAILY_JOURNAL=false
NEXT_PUBLIC_DREAM_CITY=false
NEXT_PUBLIC_PARENT_REENGAGEMENT=false
NEXT_PUBLIC_HABIT_PROGRAMS=false
NEXT_PUBLIC_AGE_THEME=false
# Publish legal links and require checkout acceptance only after owner/legal approval.
NEXT_PUBLIC_LEGAL_PAGES_APPROVED=false
# Official customer-support inbox. Keep empty until the owner approves the address.
SUPPORT_EMAIL=

# Transactional lifecycle email. Keep disabled until the sender domain, privacy
# review, migration and dispatch smoke test are complete.
LIFECYCLE_EMAILS_ENABLED=false
RESEND_API_KEY=
# resend (default) or brevo; Brevo needs BREVO_API_KEY instead of RESEND_API_KEY
LIFECYCLE_EMAIL_PROVIDER=resend
BREVO_API_KEY=
LIFECYCLE_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Minimum 32 random characters; must match the scheduler secret.
CRON_SECRET=

# PayOS VietQR Payment Gateway (required for checkout and webhook processing)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Unsafe legacy/demo server routes are disabled by default and ignored in production.
ENABLE_PAYMENT_SIMULATION=false
ENABLE_LEGACY_PAIRING=false
# Minimum 32 random characters in deployed environments.
PAIRING_RATE_LIMIT_SECRET=
# Minimum 32 random characters, required in production: signs the parent unlock cookie apart from pairing.
# Outside production, PAIRING_RATE_LIMIT_SECRET signs it when this is empty.
PARENT_UNLOCK_SECRET=

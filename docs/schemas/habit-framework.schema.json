{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodhabittracking.vanhoa2191.workers.dev/schemas/habit-framework.schema.json",
  "title": "KidHabit Habit Framework Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "sources",
    "stages",
    "concepts",
    "habits",
    "operatingModel"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "review", "published", "retired"] },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/ageStage" }
    },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/concept" }
    },
    "habits": {
      "type": "array",
      "items": { "$ref": "#/$defs/habitTemplate" }
    },
    "operatingModel": { "$ref": "#/$defs/operatingModel" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "required": ["vi"],
      "additionalProperties": { "type": "string", "minLength": 1 },
      "properties": {
        "vi": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 },
        "it": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 },
        "ja": { "type": "string", "minLength": 1 },
        "ko": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "title", "sha256", "reviewStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-[0-9]{2}$" },
        "role": { "enum": ["structure", "concept", "scientific", "safety"] },
        "title": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "location": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } },
        "reviewStatus": { "enum": ["unverified", "source-reviewed", "independently-verified"] },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "ageStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ageMinMonths",
        "ageMaxMonthsExclusive",
        "name",
        "adultRole",
        "entranceCriteria",
        "autonomy"
      ],
      "properties": {
        "id": { "enum": ["GD1", "GD2", "GD3", "GD4", "GD5"] },
        "ageMinMonths": { "type": "integer", "minimum": 0, "maximum": 215 },
        "ageMaxMonthsExclusive": { "type": "integer", "minimum": 1, "maximum": 216 },
        "name": { "$ref": "#/$defs/localizedText" },
        "adultRole": { "$ref": "#/$defs/localizedText" },
        "entranceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/localizedText" }
        },
        "autonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adultPercent", "childPercent"],
          "properties": {
            "adultPercent": { "enum": [90, 70, 40, 20, 10] },
            "childPercent": { "enum": [10, 30, 60, 80, 90] }
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "sourceMeaning",
        "appInterpretation",
        "sourceRefs",
        "reviewStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(WEALTH|CD|TALENT|PERSON|GIVING|ACTION)-[0-9]{2}$"
        },
        "kind": { "enum": ["wealth", "portrait", "talent", "person-role", "giving", "action-quality"] },
        "name": { "$ref": "#/$defs/localizedText" },
        "sourceMeaning": { "$ref": "#/$defs/localizedText" },
        "appInterpretation": { "$ref": "#/$defs/localizedText" },
        "sourceAliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "reviewStatus": { "enum": ["unverified", "source-reviewed", "approved"] }
      }
    },
    "conceptLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptId", "relation"],
      "properties": {
        "conceptId": { "type": "string", "pattern": "^(WEALTH|CD|TALENT|PERSON|GIVING|ACTION)-[0-9]{2}$" },
        "relation": { "enum": ["develops", "expresses", "practices", "supports"] },
        "note": { "$ref": "#/$defs/localizedText" }
      }
    },
    "activityVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "steps", "cadence", "qualityGate"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9-]+-V[0-9]{2}$" },
        "actor": { "enum": ["parent", "child", "family"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/localizedText" }
        },
        "cadence": { "enum": ["daily", "weekly", "monthly", "situational"] },
        "durationMinutes": { "type": "integer", "minimum": 0, "maximum": 180 },
        "adultSupport": { "type": "integer", "minimum": 0, "maximum": 100 },
        "qualityGate": { "$ref": "#/$defs/qualityGate" },
        "safetyNotes": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } }
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simple", "joyful", "gentle", "trusting", "regular", "intentional", "passedCount"],
      "properties": {
        "simple": { "type": "boolean" },
        "joyful": { "type": "boolean" },
        "gentle": { "type": "boolean" },
        "trusting": { "type": "boolean" },
        "regular": { "type": "boolean" },
        "intentional": { "type": "boolean" },
        "passedCount": { "type": "integer", "minimum": 4, "maximum": 6 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "cadence", "selfComparisonOnly"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9-]+-M[0-9]{2}$" },
        "method": { "$ref": "#/$defs/localizedText" },
        "cadence": { "enum": ["event", "daily", "weekly", "quarterly"] },
        "selfComparisonOnly": { "const": true },
        "threshold": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "evidenceRef": { "type": "string" }
      }
    },
    "habitTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "stageIds",
        "primaryDomain",
        "name",
        "purpose",
        "childMeaning",
        "parentGuidance",
        "entranceCriteria",
        "successSignals",
        "conceptLinks",
        "activityVariants",
        "measurements",
        "sourceRefs",
        "reviewStatus"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^GD[1-5]-(NT|SK|MQH|HT|TC)-[0-9]{2}$" },
        "sourceAliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "status": { "enum": ["draft", "review", "published", "retired"] },
        "stageIds": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["GD1", "GD2", "GD3", "GD4", "GD5"] },
          "uniqueItems": true
        },
        "primaryDomain": { "enum": ["NT", "SK", "MQH", "HT", "TC"] },
        "pairedDomains": {
          "type": "array",
          "items": { "enum": ["NT", "SK", "MQH", "HT", "TC"] },
          "uniqueItems": true
        },
        "name": { "$ref": "#/$defs/localizedText" },
        "purpose": { "$ref": "#/$defs/localizedText" },
        "childMeaning": { "$ref": "#/$defs/localizedText" },
        "parentGuidance": { "$ref": "#/$defs/localizedText" },
        "entranceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } },
        "successSignals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } },
        "safetyNotes": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
        "conceptLinks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conceptLink" } },
        "activityVariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/activityVariant" } },
        "measurements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/measurement" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "reviewStatus": { "enum": ["unverified", "source-reviewed", "scientifically-reviewed", "approved"] },
        "localizationKey": { "type": "string", "pattern": "^habit\\.[a-z0-9_.-]+$" }
      }
    },
    "operatingModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumQualityGatePassed", "frameworkComparison", "pointsAreFrameworkEvidence", "healthClaimsRequireIndependentReview"],
      "properties": {
        "minimumQualityGatePassed": { "const": 4 },
        "frameworkComparison": { "const": "self-only" },
        "pointsAreFrameworkEvidence": { "const": false },
        "healthClaimsRequireIndependentReview": { "const": true }
      }
    }
  }
}

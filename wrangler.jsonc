{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goodhabittracking",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENABLE_THINKING_GAMES": "true",
    "LIFECYCLE_EMAIL_PROVIDER": "brevo",
    "LIFECYCLE_EMAIL_FROM": "KidHabit Hero <no-reply@kidhabithero.com>",
    "LIFECYCLE_EMAILS_ENABLED": "true",
    "LIFECYCLE_CARE_EMAILS_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
